{
  "scene": {
    "tick_minutes": 30,
    "tick_interval_seconds": 30,
    "start": {
      "day": 1,
      "hour": 20.0,
      "weather": "cloudy",
      "location": "yard",
      "character_state": "idle",
      "affinity": 40.0
    },
    "events_file": "events.json",
    "state_file": "state.json",
    "anti_silence_minutes": 60,
    "follow_up_minutes": 90,
    "sync_to_utc8": true,
    "event_rate_multiplier": 0.45
  },
  "persona": {
    "name": "胡桃",
    "tags": [
      "weather",
      "nature",
      "stargazing",
      "festival",
      "ghost_story",
      "business",
      "missing_you",
      "greeting",
      "drama",
      "food",
      "music",
      "opera"
    ]
  },
  "decision": {
    "proactiveness": "balanced",
    "dnd_hours": [
      0,
      7
    ],
    "suppress_after_user_minutes": 3.0,
    "min_interval_minutes": 20,
    "max_interval_minutes": 90
  },
  "delivery": {
    "channels": [
      {
        "name": "openclaw_sessions",
        "config": {
          "mode": "cli",
          "agent": "main",
          "session_key": "agent:main:liyue-scene-{date}",
          "model": "deepseek/deepseek-v4-flash",
          "reply_channel": "openclaw-weixin",
          "reply_to": "YOUR_WECHAT_OPENID@im.wechat",
          "reply_account": "YOUR_BOT_ACCOUNT",
          "timeout": 180,
          "display_url": "http://127.0.0.1:8630/say",
          "multi_bubble": true,
          "max_bubbles": 3,
          "bubble_base_delay": 0.6,
          "user_session_key": "agent:main:openclaw-weixin:direct:YOUR_ACCOUNT",
          "interrupt_check": true,
          "interrupt_within_sec": 90,
          "bubble_delay_range": [
            0.6,
            3.0
          ],
          "long_bubble_extra_delay": 2.5
        }
      },
      {
        "name": "console"
      }
    ]
  },
  "memory_file": "logs/topic_memory.json",
  "memory_limit": 15,
  "security": {
    "weixin_owner_ids": [
      "YOUR_WECHAT_OPENID@im.wechat"
    ]
  }
}